@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@Html.AntiForgeryToken()

@{
    <!--Obtiene los datos de la sesión-->
    var session = HttpContextAccessor.HttpContext?.Session;
    string idUsuario = session?.GetString("IdUsuario");
    string nombreUsuario = session?.GetString("NombreUsuario");
    string rolUsuario = session?.GetString("RolUsuario");
    string descripcionRol = "";
    <!-- Contenido para el rol de Administrador -->
    if (rolUsuario == "A")
    {
        descripcionRol = "Administrador";
    }
    else
    {
        descripcionRol = "Usuario";
    }
}

<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"]</title>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <!--Bootstarp-->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <!--font-awsome para los íconos-->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    </head>

    <body>
        <!--Encabezado dentro del body-->
         <header class="border-0">
            <!--Menu de usuarios y sesión-->
            @if (!string.IsNullOrEmpty(idUsuario))
            {
                <nav class="navbar navbar-expand-sm bg-secondary navbar-secondary py-2">
                    <div class="container-fluid">
                        <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu_sedarpa">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="menu_sedarpa">
                            <ul class="navbar-nav me-auto mb-0 pt-3 pt-sm-0">
                                <li class="nav-item">
                                    <a href="#" class="nav-link text-white">
                                        <i class="fa fa-user-circle-o pe-2" aria-hidden="true"></i>Usuario: @nombreUsuario
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="#" class="logout-link nav-link text-white">
                                        <i class="fa fa-sign-out pe-2" aria-hidden="true"></i>Cerrar sesión
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Seguimiento")" class="nav-link text-white">
                                        <i class="fa fa-home pe-2" aria-hidden="true"></i>Inicio
                                    </a>
                                </li>
                            </ul>
                            <!-- Un formulario alineado a la derecha en forma de fila (d-flex)
                            <form class="d-flex pt-3 pt-sm-0">
                                <input class="form-control me-2" placeholder="Buscar">
                                <button class="btn btn-outline-light" type="submit">Buscar</button>
                            </form>-->
                        </div>
                    </div>
                </nav>
            }
            <!--Encabezado de logotipos-->
            <div class="container-fluid d-flex flex-column flex-md-row w-100 justify-content-between">
                <div class="m-2 py-2 px-3">
                    <img src="~/logo-sedarpa.png" style="width: 50%; height: auto;">
                </div>
                <div class="m-2 py-2 px-3 text-md-start text-md-end">
                    <img src="~/LogoOficialPorAmorVer.png" style="width: 50%; height: auto;" />
                </div>
            </div>
           
        <p class="fw-bolder w-100 p-3 text-center" style="color:#691933; text-align:center">SUBDIRECCIÓN DE SISTEMAS DE PRODUCCIÓN REGIONAL<br />SISTEMA DE AUTOMATIZACIÓN Y GESTIÓN DE APOYOS AGROPECUARIO (SAGAA)</p>
        </header>
        <!--Espacio pafra el render de las páginas hijas-->
        <div class="container w-100">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
        <!--Pie de página dentro del body-->
         <footer class="footer text-muted border-0">
            <div class="container">
            </div>
        </footer>

        <!--Inserción de librerias de java script-->
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/js/paginacion.js" asp-append-version="true"></script>
        <script src="~/js/padronBeneficiarios.js" asp-append-version="true"></script>
        
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>     
        <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

        @await RenderSectionAsync("Scripts", required: false)

    </body>

</html>

<script>

    // Agrega un evento de clic al enlace de cerrar sesión
    document.addEventListener('DOMContentLoaded', function () {
        const logoutLink = document.querySelector('.logout-link');
        if (logoutLink) {
            logoutLink.addEventListener('click', function (event) {
                event.preventDefault(); // Evita la acción predeterminada del enlace
                cerrarSesion(); // Llama a la función para cerrar sesión
            });
        }
    });

    async function cerrarSesion() {
        // Obtener el AntiForgeryToken si existe en la página
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        const formData = new FormData();
        formData.append("__RequestVerificationToken", token);

        try {
            const response = await fetch('/Seguimiento/CerrarSesion', {
                method: 'POST',
                body: formData
            });

            // Al completarse la redirección del controlador, se redirige al navegador
            if (response.redirected) {
                window.location.href = response.url;
            } else {
                window.location.href = '/Seguimiento/Inicio';
            }
        } catch (error) {
            console.error('Error al cerrar sesión:', error);
        }
    }

</script>
