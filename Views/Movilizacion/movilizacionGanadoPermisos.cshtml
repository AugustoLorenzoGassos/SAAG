@model IEnumerable<Seguimiento.Models.SolicitudInternacion>

@{
    ViewData["Title"] = "Movilización de ganado - Solicitudes de internación";
}

<div class="container  mt-3">

    <div class="card">
        <div class="card-header bg-secondary text-white bg-gradient ">
            <h4 class="m-0">Movilización de ganado - Permisos de internación</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-3">
                    <label for="txtSolicitud" class="form-label">Id de la solicitud:</label>
                    <input type="number" id="txtSolicitud" class="form-control" placeholder="Id de la solicitud" />
                </div>
                <div class="col-12 col-md-3">
                    <label for="txtFecha" class="form-label">Fecha de la solicitud:</label>
                    <input type="date" id="txtFecha" class="form-control" placeholder="Fecha de la solicitud" />
                </div>
                <div class="col-12 col-md-3">
                    <label for="txtCertificado" class="form-label">Certificado zoosanitario:</label>
                    <input type="text" id="txtCertificado" class="form-control" placeholder="Certificado zoosanitario" />
                </div>
                <div class="col-12 col-md-3">
                    <label for="cmbStatus" class="form-label">Status de la solicitud:</label>
                    <select id="cmbStatus" class="form-select">
                        <option value=0>Selecciona un status...</option>
                        <option value=1>Enviada</option>
                        <option value=2>En proceso de atención</option>
                        <option value=3>Solicitud rechazada</option>
                        <option value=4>Solicitud aceptada</option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <label for="txtNombre" class="form-label">Nombre del solicitante:</label>
                    <input type="text" id="txtNombre" class="form-control" placeholder="Nombre del solicitante" />
                </div>
            </div>

            <!--Tabla para mostrar las solicitudes de internación-->
            <div class="table-responsive">
                <table id="TblSolicitudesInternacion" class="table table-striped mt-4 table-hover table-bordered w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Id</th>      
                            <th>Certificado Zoosanitario</th>
                            <th>Fecha solicitud</th>
                            <th>Origen</th>
                            <th>Destino</th>
                            <th>Tipo de ganado</th>
                            <th>Motivo de traslado</th>
                            <th>Status</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyRegistros">
                        @foreach (var itemSolicitud in Model)
                        {
                            <tr>
                                <td>@itemSolicitud.IdSolicitudInternacion</td>
                                <td>@itemSolicitud.CertificadoMovilizacion</td>
                                <td>@itemSolicitud.FechaSolicitud</td>
                                <td>@itemSolicitud.Origen</td>
                                <td>@itemSolicitud.Destino</td>
                                <td>@itemSolicitud.TipoGanadoNavigation.DescTipoGanado</td>
                                <td>@itemSolicitud.MotivoTrasladoNavigation.DescMotivoTraslado</td>
                                <td>@itemSolicitud.StatusSolicitudNavigation.DescStatusSolicitud</td>
                                <td>

                                    <div class="btn-group btn-group-sm" role="group" aria-label="Acciones">
                                        <button type="button" class="btn btn-detalles position-relative" onclick="mostrarDetalles(@itemSolicitud.IdSolicitudInternacion)">
                                            <i class="fa fa-address-card" aria-hidden="true"></i>
                                            @if (itemSolicitud.SolicitudInternacionDocumentos.Count()> 0)
                                            {
                                                <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle" style="font-size:x-small;">
                                                    @itemSolicitud.SolicitudInternacionDocumentos.Count()
                                                </span>
                                            }
                                        </button>
                                    </div>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <!-- Controles de Paginación -->
            <div class="d-flex justify-content-between align-items-center mt-3">
                <small class="text-muted" id="infoPaginacion"></small>
                <nav>
                    <ul class="pagination pagination-sm mb-0" id="ulPaginacion"></ul>
                </nav>
            </div>
            
        </div>
        <div class="card-footer">
            <div class="container-fluid d-flex flex-column flex-md-row w-100 justify-content-start">
                <div class="me-md-2">
                    <button type="button" id="btnFiltrar" class="btn btn-light w-100 w-md-auto" onclick="mostrarPermisosInternacion();">
                        <!-- Botón para filtrar registros -->
                        <i class="fa fa-search me-1" aria-hidden="true"></i> Filtrar solicitudes
                    </button>
                </div>
            </div>
        </div>
    </div>



</div>

<script>

    document.addEventListener("DOMContentLoaded", function() {
        inicializarPaginacion();
    });

    async function mostrarPermisosInternacion() 
    {
        //Varianles para el filtrotxtCertificado
        const id = document.getElementById('txtSolicitud').value;
        const nombre = document.getElementById('txtNombre').value;
        const Fecha = document.getElementById('txtFecha').value;
        const certificado = document.getElementById('txtCertificado').value;
        const status = document.getElementById('cmbStatus').value;

        //Preparación de la tabla para mostrar los datos
        document.getElementById("TblSolicitudesInternacion").classList.remove("d-none");
        const tbody = document.getElementById("tbodyRegistros");
        tbody.innerHTML = "";

        const params = new URLSearchParams();
        if (id) params.append('id', id);
        if (nombre) params.append('nombre', nombre);
        if (Fecha) params.append('fecha', Fecha);   
        if (certificado) params.append('certificado', certificado);
        if (status > 0) params.append('status', status);

        //Obtención de los datos desde el servidor
        try 
        {
            const response = await fetch(`/Movilizacion/SolicitudesInternacion?${params.toString()}`);
            if (!response.ok) 
            {
                throw new Error(`Error en la petición: ${response.statusText}`);
            }
            const data = await response.json();
            if (!data || data.length === 0) 
            {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center">No se encontraron registros.</td></tr>';
                return;
            }
            else 
            {
                //Limpia la tabla y la llena con la información regresada por el controlador
                tbody.innerHTML = '';
                data.forEach(item => {
                    //Genera la badges para mostrar el número de documentos asociados a la solicitud
                    const badgeHtml = (item.totalDocumentos > 0) 
                    ? `<span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle" style="font-size:x-small;">${item.totalDocumentos}</span>` 
                    : '';
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                                <td>${item.idSolicitudInternacion ?? '-'}</td>
                                <td>${item.certificadoMovilizacion ?? '-'}</td>
                                <td>${formatearFecha(item.fechaSolicitud ?? '-')}</td>
                                <td>${item.origen ?? '-'}</td>
                                <td>${item.destino ?? '-'}</td>
                                <td>${item.descTipoGanado ?? '-'}</td>
                                <td>${item.descMotivoTraslado }</td>
                                <td>${item.descStatusSolicitud}</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Acciones">
                                        <!-- Acciones de seguimiento -->
                                        <button type="button" position-relative class="btn btn-detalles" onclick="mostrarDetalles(${item.idSolicitudInternacion})">
                                            <i class="fa fa-address-card" aria-hidden="true"></i>
                                            ${badgeHtml}
                                        </button>
                                    </div>
                                </td>
                            `;
                    tbody.appendChild(tr);
                });
                //Coloca los controles para la paginación
                inicializarPaginacion();
            }
        }
        catch (error) 
        {
            console.error(error);
            tbody.innerHTML = '<tr><td colspan="9" class="text-center text-danger">Error al cargar los datos.</td></tr>';
        }
    }

    function formatearFecha(fechaIso) {
        if (!fechaIso) return '-';
        // Divide "2026-09-03" por el guion
        const partes = fechaIso.split('T')[0].split('-'); 
        if (partes.length !== 3) return fechaIso;
    
        const [year, month, day] = partes;
        return `${day}/${month}/${year}`; // Retorna "03/09/2026"
    }

    function mostrarDetalles(idSolicitud) 
    {
        // Redirige a la vista de detalles de la solicitud
        window.location.href = `/Movilizacion/SolicitudesInternacionDetalle/${idSolicitud}`;
    }

</script>