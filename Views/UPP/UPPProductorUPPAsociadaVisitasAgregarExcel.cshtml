@{
    ViewData["Title"] = "Registro de productores - Visitas UPP - Agregar desde excel";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-secondary bg-gradient text-white">
            <h4 class="m-0">Registro de productores - Visitas UPP - Agregar desde excel</h4>
        </div>
        <div class="card-body">
            <form action="/UPP/UPPProductorUPPAsociadaVisitasAgregarExcel" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div>
                    <label for="archivoExcel">Seleccione el archivo Excel (.xlsx):</label>
                    <input type="file" id="archivoExcel" name="archivoExcel" accept=".xlsx" required />
                </div>
                <button type="submit" class="btn btn-secondary mt-2">Cargar archivo</button>
                <div class="alert alert-warning p-2 m-4" role="alert">
                    <h4 class="text-center">Resultado del proceso de carga</h4>
                    <h5 class="text-center mt-2">
                        @if (TempData["Mensaje"] != null)
                        {
                            @Html.Raw(TempData["Mensaje"])
                        }
                    </h5>
                    @if (ViewBag.MostrarBotonDescarga != null && (bool)ViewBag.MostrarBotonDescarga){
                        <a href="@Url.Action("DescargarExcelConErrores", "Seguimiento")" class="btn btn-danger mt-2">
                            <i class="fa fa-download me-1" aria-hidden="true"></i>Descargar registros con errores
                        </a>
                    }
                </div>
            </form>
        </div>
        <div class="card-footer">
            <!-- Botones de acción en flex responsivo -->
            <div class="container-fluid d-flex flex-column flex-md-row w-100 justify-content-start">
                <div class="me-md-2">
                    <!-- Acción para regresar a la lista de productores -->
                    <a href="@Url.Action("UPPInicio", "UPP")" class="btn btn-light w-100 w-md-auto">
                        <i class="fa fa-bars me-1" aria-hidden="true"></i>Regresar a la lista de productores
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>