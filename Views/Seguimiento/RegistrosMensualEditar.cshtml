@model Seguimiento.Models.TblRegistroMensual

@{
    ViewData["Title"] = "Editar de Registro Mensual";
}

<div class="container mt-4">
    <form id="formRegistroMensual" action="/Seguimiento/RegistrosMensualEditar" method="POST">
        <div class="card">
            <div class="card-header bg-secondary bg-gradient text-white">
                <h4 class="m-0">Registro mensual - Editar</h4>
            </div>
            <div class="card-body">
                <!-- Token de seguridad Anti-Forgery Obligatorio -->
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.IdReporteMensual)
                @Html.HiddenFor(model => model.IdUsuario)
                @Html.HiddenFor(model => model.FechaCaptura)
                <!-- Sección de selección de laboratorio, mes y año -->
                <div class="row">
                    <!-- Selección de Laboratorio -->
                    <div class="col-md-4 mb-3">
                        <label for="cmbLaboratorios" class="form-label">Laboratorio:</label>
                        <select id="cmbLaboratorios" name="IdLaboratorio" class="form-select" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <!-- Selección de Mes -->
                    <div class="col-md-4 mb-3">
                        <label for="cmbMes" class="form-label">Mes del Reporte:</label>
                        <select id="cmbMes" name="MesReporte" class="form-select" required>
                            <option value="">Seleccione el mes... </option>
                            <option value="1" selected="@(Model.MesReporte == 1)">Enero</option>
                            <option value="2" selected="@(Model.MesReporte == 2)">Febrero</option>
                            <option value="3" selected="@(Model.MesReporte == 3)">Marzo</option>
                            <option value="4" selected="@(Model.MesReporte == 4)">Abril</option>
                            <option value="5" selected="@(Model.MesReporte == 5)">Mayo</option>
                            <option value="6" selected="@(Model.MesReporte == 6)">Junio</option>
                            <option value="7" selected="@(Model.MesReporte == 7)">Julio</option>
                            <option value="8" selected="@(Model.MesReporte == 8)">Agosto</option>
                            <option value="9" selected="@(Model.MesReporte == 9)">Septiembre</option>
                            <option value="10" selected="@(Model.MesReporte == 10)">Octubre</option>
                            <option value="11" selected="@(Model.MesReporte == 11)">Noviembre</option>
                            <option value="12" selected="@(Model.MesReporte == 12)">Diciembre</option>
                        </select>
                    </div>
                    <!-- Año del Reporte -->
                    <div class="col-md-4 mb-3">
                        <label for="txtAño" class="form-label">Año del Reporte:</label>
                        <input type="number" id="txtAño" name="AñoReporte" class="form-control" value="@Model.AñoReporte" min="2020" max="2030" required />
                    </div>
                </div>
                <!-- Mensaje de respuesta-->
                <div id="mensajeRespuesta" class="mt-3"></div>
            </div>
            <div class="card-footer">
                <!-- Botones de acción en flex responsivo -->
                <div class="container-fluid d-flex flex-column flex-md-row w-100 justify-content-start">
                    <div class="me-md-2">
                        <!-- Acción para regresar a la lista de registros mensuales -->
                        <a href="@Url.Action("RegistrosMensualInicio", "Seguimiento")" class="btn btn-light w-100 w-md-auto">
                            <i class="fa fa-bars me-1" aria-hidden="true"></i>Regresar a la lista de registros mensuales
                        </a>
                    </div>
                    <div class="mt-2 mt-md-0">
                        <!-- Botón para guardar un registro nuevo -->
                        <button type="submit" id="btnGuardar" class="btn btn-light w-100 w-md-auto">
                            <i class="fa fa-save me-1" aria-hidden="true"></i>Guardar Registro
                        </button>
                    </div>
                    @*<div class="mt-2 mt-md-0">
                        <!-- Acción para registrar acciones de laboratorio móvil, inicialmente oculto -->
                        <a id="btnRegistrarAcciones" href="@Url.Action("laboratorioMovilVerRegistroMensual", "Seguimiento", new { id = 0, id1 = 0, id2 = 0 })" class="btn btn-success w-100 w-md-ato" style="display: none;">
                            <i class="fa fa-tasks me-1" aria-hidden="true"></i>Registrar acciones de laboratorio móvil
                        </a>
                    </div>*@
                </div>
            </div>
        </div>
    </form>
</div>

<script>

    //Inicio del script, se ejecuta cuando el DOM está completamente cargado
    document.addEventListener("DOMContentLoaded", function ()
    {
        //Llena el combo de laboratorios al cargar la página
        cargarLaboratorios();
    });

    //Función para cargar los laboratorios en el combo
    async function cargarLaboratorios()
    {
        //Obtiene el elemento select del DOM
        const cmbLaboratorios = document.getElementById("cmbLaboratorios");
        //Sección para realizar la petición al controlador y llenar el combo (Try, catch para manejar errores))
        try
        {
            // Realizar la petición GET al controlador
            const response = await fetch('/Seguimiento/ObtenerLaboratorios');
            const idLaboratorioGuardado = "@Model.IdLaboratorio";
            //Error en la respuesta HTTP
            if (!response.ok)
            {
                throw new Error(`Error HTTP: ${response.status}`);
            }
            // Convertir la respuesta a JSON del controlador
            const data = await response.json();
            // Limpiar opciones anteriores excepto la opción por defecto
            cmbLaboratorios.innerHTML = '<option value="">Seleccione un laboratorio... </option>';
            // Recorrer el arreglo devuelto y agregar las opciones al select
            data.forEach(item =>
            {
                const option = document.createElement("option");
                option.value = item.idLaboratoio;
                option.textContent = item.nombreLaboratorio;
                if (item.idLaboratoio == idLaboratorioGuardado) {
                    option.selected = true;
                }
                cmbLaboratorios.appendChild(option);
            });
        }
        catch (error)
        {
            console.error("Error al cargar la lista de laboratorios:", error);
        }
    }
</script>