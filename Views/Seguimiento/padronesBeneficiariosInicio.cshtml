@{
    ViewData["Title"] = "Padrones de beneficiarios";
}

<div class="modal" id="modalRegistro" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitulo"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalCuerpo">
                <div>
                    <label for="txtNombre">Nombre del beneficiario:</label>
                    <input id="txtNombreModal" class="form-control w-100 my-2" />
                </div>
                <div id="contenedorIATF" class="container"></div>
                <div id="tblApicultura" class="table-responsive d-none">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th class="text-center">Descripción</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-center">Precio unitario</th>
                                <th class="text-center">Importe</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyApoyos">
                        </tbody>
                    </table>
                    <div class="text-end">
                        <label id="lblTotalApoyos">Total de apoyos: </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer" id="modalPie">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <!-- Columna de la Izquierda: Menú Navegación -->
        <nav class="col-12 col-md-3 col-lg-2 bg-dark navbar-dark h-auto min-vh-md-100 p-3">
            <!-- Botón Toggler para pantallas pequeñas (Móviles) -->
            <button class="navbar-toggler d-md-none mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#menu_padrones">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse d-md-block" id="menu_padrones">
                <!-- flex-column orientación vertical -->
                <ul class="navbar-nav flex-column me-auto mb-0">
                    <li class="nav-item">
                        <a id="btnApicultura" class="nav-link active border-bottom p-2" data-seccion="sec-apicultura" href="#" onclick="mostrarSeccion(event,'sec-apicultura')">Apicultura</a>
                    </li>
                    <li class="nav-item">
                        <a id="btnAcuacultura" class="nav-link border-bottom p-2" data-seccion="sec-Acuacultura" href="#" onclick="mostrarSeccion(event,'sec-Acuacultura')">Proyecto Desarrollo de la Acuacultura Sustentable Veracruzana</a>
                    </li>
                    <li class="nav-item">
                        <a id="btnAves" class="nav-link border-bottom p-2" data-seccion="sec-aves" href="#" onclick="mostrarSeccion(event,'sec-aves')">Impulso y Fomento a la Producción de Aves de Postura de Traspatio</a>
                    </li>
                    <li class="nav-item">
                        <a id="btnInseminacion" class="nav-link border-bottom p-2" data-seccion="sec-inseminacion" href="#" onclick="mostrarSeccion(event,'sec-inseminacion')">Fortalecimiento a la Producción Lechera y Mejoramiento Genético en Bovinos con Tecnología Reporductiva</a>
                    </li>
                    <li class="nav-item">
                        <a id="btnMapas" class="nav-link p-2" data-seccion="sec-mapas" href="#" onclick="mostrarSeccion(event,'sec-mapas')">Ver mapas de ubicación geográfica</a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Columna de la Derecha: Contenido Principal -->
        <main class="col-12 col-md-9 col-lg-10 p-4">
            <!--Filtros de información-->
            <div class="row">
                <div class="col-12 col-md-3">
                    <label for="cmbRegion" class="form-label">Región:</label>
                    <select id="cmbRegion" class="form-select">
                        <option value="00">Selecciona una región...</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label for="cmbMunicipio" class="form-label">Municipio:</label>
                    <select id="cmbMunicipio" class="form-select">
                        <option value="000">Selecciona un municipio...</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label for="cmbLocalidad" class="form-label">Localidad:</label>
                    <select id="cmbLocalidad" class="form-select">
                        <option value="0000">Selecciona una localidad...</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label for="txtAño" class="form-label">Año del Reporte:</label>
                    <input type="number" class="form-control" id="txtAño" />
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <label for="txtNombre" class="form-label">Nombre:</label>
                    <input type="text" class="form-control" id="txtNombre" />
                </div>
            </div>
            <!-- Sección de padrones -->
            <div id="divPadrones" class="d-none">
                <!--Secciones pará presentar-->
                <section id="sec-apicultura" class="seccion-contenido mt-3">
                    <h4 class="text-center mb-3">Apicultura</h4>
                </section>
                <section id="sec-Acuacultura" class="seccion-contenido mt-3 d-none">
                    <h4 class="text-center mb-3">Proyecto Desarrollo de la Acuacultura Sustentable Veracruzana</h4>
                </section>
                <section id="sec-aves" class="seccion-contenido mt-3 d-none">
                    <h4 class="text-center mb-3">Impulso y Fomento a la Producción de Aves de Postura de Traspatio en la Entidad Veracruzana</h4>
                </section>
                <section id="sec-inseminacion" class="seccion-contenido mt-3 d-none">
                    <h4 class="text-center mb-3">Fortalecimiento a la Producción Lechera y Mejoramiento Genético en Bovinos con Tecnología Reporductiva</h4>
                </section>
                <!-- Tabla de Resultados -->
                <div class="card">
                    <div class="card-header bg-secondary bg-gradient text-white">
                        <h4 class="m-0">Padron de beneficiarios</h4>
                    </div>
                    <div class="card-body">
                        <!--Descargas a excel-->
                        <div class="text-end">
                            <a href="#" id="btnDescargar" class="btn btn-secondary">
                                <i class="fa fa-file-excel-o me-1" aria-hidden="true"></i>Descargar a excel
                            </a>
                        </div>
                        <!--Tabla de resultados-->
                        <div class="table-responsive mt-3 w-10">
                            <table class="table table-striped table-hover table-bordered" style="font-size:small" id="tablaRegistros">
                                <thead id="theadRegistros" class="table-light">
                                </thead>
                                <tbody id="tbodyRegistros">
                                    <tr>
                                        <td colspan="9" class="text-center">Presione "Filtrar padrón" para obtener los datos.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- Controles de Paginación -->
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-muted" id="infoPaginacion"></small>
                            <nav>
                                <ul class="pagination pagination-sm mb-0" id="ulPaginacion"></ul>
                            </nav>
                        </div>
                    </div>
                    <div class="card-footer">
                        <!-- Botones de acción en flex responsivo -->
                        <div class="container-fluid d-flex flex-column flex-md-row w-100 justify-content-start">
                            <div class="me-md-2">
                                <button type="button" id="btnFiltrar" class="btn btn-light w-100 w-md-auto">
                                    <!-- Botón para filtrar registros -->
                                    <i class="fa fa-search me-1" aria-hidden="true"></i> Filtrar padrón
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Sección de mapas -->
            <div id="divPadronesMapa" class="d-none">
                <div class="row mb-3">
                    <div class="col-12">
                        <label for="cmbPadron" class="form-label">Padrón:</label>
                        <select id="cmbPadron" class="form-select">
                            <option value="0000">Selecciona un padrón...</option>
                            <option value="AC">Apicultura</option>
                            <option value="DASV">Proyecto Desarrollo de la Acuacultura Sustentable Veracruzana</option>
                            <option value="IATF">Fortalecimiento a la Producción Lechera y Mejoramiento Genético en Bovinos con Tecnología Reporductiva</option>
                            <option value="IFPAPTEV">Impulso y Fomento a la Producción de Aves de Postura de Traspatio en la Entidad Veracruzana</option>
                        </select>
                    </div>
                    <!--<div class="col-12 col-md-3">
                        <label for="cmbRegionMapa" class="form-label">Región:</label>
                        <select id="cmbRegionMapa" class="form-select">
                            <option value="00">Selecciona una región...</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label for="cmbMunicipioMapa" class="form-label">Municipio:</label>
                        <select id="cmbMunicipioMapa" class="form-select">
                            <option value="000">Selecciona un municipio...</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label for="cmbLocalidadMapa" class="form-label">Localidad:</label>
                        <select id="cmbLocalidadMapa" class="form-select">
                            <option value="0000">Selecciona una localidad...</option>
                        </select>
                    </div>-->
                </div>
                <div class="card">
                    <div class="card-header bg-secondary bg-gradient text-white">
                        <h4 class="m-0">Mapas de distribución geográfica de beneficiarios</h4>
                    </div>
                    <div class="card-body">
                        <div class="text-end">
                            <button id="btnExportar" class="btn btn-secondary mb-3">
                                <i class="fa fa-download"></i> Exportar a PNG
                            </button>
                        </div>
                        <div id="mapa" style="height: 800px; width: 100%;"></div>
                    </div>
                    @*<div class="card-footer">
                    </div>*@
                </div>

            </div>
        </main>
    </div>
</div>

<script>

    //Variables para el mapa y el grupo de marcadores
    var map = null;
    var marcadoresGroup = null;

    let urlDescargaActual = '/Seguimiento/padronesBeneficiariosApiculturaDescarga';

    document.addEventListener("DOMContentLoaded", function () 
    {
        const txtAño = document.getElementById("txtAño");
        if (txtAño) 
        {
            txtAño.value = new Date().getFullYear();
        }
        cargarRegiones();
        cargarMunicipios();
        //cargarTablaApiCultura();
        document.getElementById('btnApicultura').click();
    });

    function mostrarSeccion(event, idSeccion) {
        if (event) event.preventDefault();
        // Ocultar todas las secciones
        const secciones = document.querySelectorAll('.seccion-contenido');
        secciones.forEach(sec => sec.classList.add('d-none'));
        // Quitar clase active a los links
        const links = document.querySelectorAll('#menu_padrones .nav-link');
        links.forEach(link => link.classList.remove('active'));
       // Activar la sección actual
        const seccionObjetivo = document.getElementById(idSeccion);
        if (seccionObjetivo) {
            seccionObjetivo.classList.remove('d-none');
        }
        if (event && event.currentTarget) {
            event.currentTarget.classList.add('active');
        }
        // Ejecutar la carga de la tabla principal sin alterar el modal
        switch (idSeccion) {
            case 'sec-apicultura':
                document.getElementById("divPadrones").classList.remove('d-none');
                document.getElementById("divPadronesMapa").classList.add('d-none');
                cargarTablaApiCultura();
                urlDescargaActual = '/Seguimiento/padronesBeneficiariosApiculturaDescarga';
                break;
            case 'sec-Acuacultura':
                document.getElementById("divPadrones").classList.remove('d-none');
                document.getElementById("divPadronesMapa").classList.add('d-none');
                cargarTablaAcuacultura();
                urlDescargaActual = '/Seguimiento/padronesBeneficiariosAcuaculturaDescarga';
                break;
            case 'sec-aves':
                document.getElementById("divPadrones").classList.remove('d-none');
                document.getElementById("divPadronesMapa").classList.add('d-none');
                cargarTablaAves();
                urlDescargaActual = '/Seguimiento/padronesBeneficiariosAvesDescarga';
                break;
            case 'sec-inseminacion':
                document.getElementById("divPadrones").classList.remove('d-none');
                document.getElementById("divPadronesMapa").classList.add('d-none');
                cargarTablaInseminacion();
                urlDescargaActual = '/Seguimiento/padronesBeneficiariosIATFDescargar';
                break;
            case 'sec-mapas':
                document.getElementById("divPadronesMapa").classList.remove('d-none');
                document.getElementById("divPadrones").classList.add('d-none');
                cargarPadronesMapa();
                break;
        }
    }

    document.getElementById('btnDescargar')?.addEventListener('click', function (e) {
        e.preventDefault();
        //window.location.href = urlDescargaActual;

        // 1. Instancias el objeto URL basado en tu variable base
        const url = new URL(urlDescargaActual, window.location.origin);

        const anioReporte = document.getElementById('txtAño').value;
        const nombre = document.getElementById('txtNombre').value;
        const region = document.getElementById('cmbRegion').value;
        const municipio = document.getElementById('cmbMunicipio').value;
        const localidad = document.getElementById('cmbLocalidad').value;

        // 2. Agregas los parámetros que necesites (clave, valor)
        if (anioReporte) url.searchParams.append('anioReporte', anioReporte);
        if (nombre) url.searchParams.append('nombre', nombre);
        if (region && region !== "00") url.searchParams.append('region', region);
        if (municipio && municipio !== "000") url.searchParams.append('municipio', municipio);
        if (localidad && localidad !== "0000") url.searchParams.append('localidad', localidad);

        // // 3. Asignas la URL con los parámetros generados
        window.location.href = url.toString();

    });

    document.getElementById('btnFiltrar')?.addEventListener('click', function (e) {
        
        e.preventDefault();

        const seccionActiva = document.querySelector('#menu_padrones .nav-link.active')?.dataset.seccion;
        switch (seccionActiva) {
            case 'sec-apicultura':
                cargarTablaApiCultura();
                break;
            case 'sec-Acuacultura':
                cargarTablaAcuacultura();
                break;
            case 'sec-aves':
                cargarTablaAves();
                break;
            case 'sec-inseminacion':
                cargarTablaInseminacion();
                break;
            default:
                console.warn('No se detectó ninguna sección activa válida.');
                break;
        }
    });

    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.btn-detalles');
        if (btn) {
            // Detiene cualquier submit o evento de la tabla principal
            e.preventDefault();
            e.stopPropagation();
            const formatoMoneda = new Intl.NumberFormat('es-MX', {
                style: 'currency',
                currency: 'MXN'
            });

            const idRegistro = btn.dataset.id;
            const seccion = btn.dataset.seccion;

            // Referencias a elementos del Modal
            const modalElemento = document.getElementById('modalRegistro');
            const modalInstance = bootstrap.Modal.getOrCreateInstance(modalElemento);
            const tbodyModal = document.getElementById('tbodyApoyos'); // tbody EXCLUSIVO del modal
            const txtNombreModal = document.getElementById("txtNombreModal");
            //Ocultar todas las tablas
            document.getElementById("tblApicultura").classList.add("d-none")
            // Limpiar controles del modal
            if (txtNombre) txtNombre.value = '';
            tbodyModal.innerHTML = `<tr><td colspan="4" class="text-center">Cargando apoyos...</td></tr>`;
            // Determinar endpoint y título según sección
            let urlEndpoint = '';
            switch (seccion) {
                case 'sec-apicultura':
                    document.getElementById('modalTitulo').innerText = "Detalle de beneficiario - Apicultura";
                    document.getElementById("tblApicultura").classList.remove("d-none");
                    urlEndpoint = `/Seguimiento/padronesBeneficiariosApiculturaBeneficiario?id=${idRegistro}`;
                    break;
                case 'sec-Acuacultura':
                    document.getElementById('modalTitulo').innerText = "Detalle de beneficiario - Acuacultura sustentable";
                    document.getElementById("tblApicultura").classList.remove("d-none");
                    urlEndpoint = `/Seguimiento/padronesBeneficiariosAcuaculturaBeneficiario?id=${idRegistro}`;
                    break;
                case 'sec-aves':
                    document.getElementById('modalTitulo').innerText = "Detalle de beneficiario - Aves de traspatio";
                    urlEndpoint = `/Seguimiento/padronesBeneficiariosAvesBeneficiario?id=${idRegistro}`;
                    break;
                case 'sec-inseminacion':
                    document.getElementById('modalTitulo').innerText = "Detalle de beneficiario - Inseminación Artificial";
                    urlEndpoint = `/Seguimiento/padronesBeneficiariosIATFBeneficiario?id=${idRegistro}`;
                    break;
                default:
                    urlEndpoint = ``;
                    break;
            }

            // Abrir Modal
            modalInstance.show();

            // Petición exclusiva para la tabla interna del modal
            var totalApoyos = 0;
            fetch(urlEndpoint)
                .then(response => {
                    if (!response.ok) throw new Error('Error al conectar con el servidor');
                    return response.json();
                })
                .then(data => {
                    if (data.success && data.registros && data.registros.length > 0) {
                        if (txtNombreModal) txtNombreModal.value = data.registros[0].nombreBeneficiarios || data.registros[0].nombre || '';
                        //Datos exclusivos de IATF
                        if (seccion == 'sec-inseminacion') {
                            const contenedorIATF = document.getElementById("contenedorIATF");
                            const filaIATF = `
                                <div class="row">
                                    <div class="col-12 col-md-4">Folio vientres:<br>${data.registros[0].folioVientres}</div>
                                    <div class="col-12 col-md-4">Folio semental:<br>${data.registros[0].folioSemental}</div>
                                    <div class="col-12 col-md-4">Número de entrega:<br>${data.registros[0].numeroEntrega1}</div>
                                </div>
                                    <div class="row mt-3">
                                        <div class="col-12 col-md-4">Número de entrega:<br>${data.registros[0].numeroEntrega2}</div>
                                        <div class="col-12 col-md-4">Sementales:<br>${data.registros[0].sementales}</div>
                                        <div class="col-12 col-md-4">Vientres:<br>${data.registros[0].vientres || 0}</div>
                                    </div>
                                `;
                            contenedorIATF.innerHTML = filaIATF;
                        }
                        tbodyModal.innerHTML = '';
                        data.registros.forEach(item => {
                            const fila = `
                                <tr>
                                    <td>${item.descripcionApoyo}</td>
                                    <td class="text-center">${item.cantidad}</td>
                                    <td class="text-end">${formatoMoneda.format(item.precioUnitario || 0)}</td>
                                    <td class="text-end">${formatoMoneda.format(item.importe || 0)}</td>
                                </tr>
                            `;
                            tbodyModal.innerHTML += fila;
                            totalApoyos += item.importe;
                        });
                        document.getElementById("lblTotalApoyos").innerHTML = `Total de apoyos: ${formatoMoneda.format(totalApoyos || 0)}`
                    } else {
                        tbodyModal.innerHTML = `<tr><td colspan="4" class="text-center text-warning">${data.message || 'No se encontraron registros.'}</td></tr>`;
                    }
                })
                .catch(error => {
                    console.error(error);
                    tbodyModal.innerHTML = `<tr><td colspan="4" class="text-center text-danger">Ocurrió un error al cargar la información.</td></tr>`;
                });
        }
    });
    
    document.getElementById('btnExportar').addEventListener('click', function() {
        var mapaElemento = document.getElementById('mapa');
        html2canvas(mapaElemento, {
            useCORS: true, // Permite cargar las imágenes de OpenStreetMap sin bloqueos de seguridad
            allowTaint: true
        }).then(function(canvas) {
            var enlace = document.createElement('a');
            enlace.download = 'Mapa_Padrones.png'; // Nombre del archivo resultante
            enlace.href = canvas.toDataURL('image/png'); // O 'image/jpeg' si prefieres JPG
            enlace.click();
        });
    });
    
    function cargarPadronesMapa() 
    {

        if (!map) {
            var limitesVeracruz = L.latLngBounds(
                L.latLng(17.10, -98.60), // Esquina Suroeste
                L.latLng(22.50, -93.50)  // Esquina Noreste
            );
        
            map = L.map('mapa', {
                maxBounds: limitesVeracruz,
                maxBoundsViscosity: 1.0,
                minZoom: 7,
                maxZoom: 18
            }).fitBounds(limitesVeracruz);

            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(map);

            marcadoresGroup = L.layerGroup().addTo(map);
        }

        setTimeout(() => { 
            if (map) map.invalidateSize(); 
        }, 200);
        //setTimeout(() => { map.invalidateSize(); }, 200);

        obtenerPuntosPadrones();

        //renderizarMapa(listaUpp);
        //cargarRegiones();
        //cargarMunicipios();

    }

    async function obtenerPuntosPadrones() 
    {
        //Generar parámetros de búsqueda según los filtros seleccionados
        const anioReporte = document.getElementById('txtAño').value;
        const nombre = document.getElementById('txtNombre').value;
        const region = document.getElementById('cmbRegion').value;
        const municipio = document.getElementById('cmbMunicipio').value;
        const localidad = document.getElementById('cmbLocalidad').value;
        const padron = document.getElementById('cmbPadron').value;
        //Agregar los valores a la URL de la petición
        const params = new URLSearchParams();
        if (anioReporte) params.append('anioReporte', anioReporte);
        if (nombre) params.append('nombre', nombre);
        if (region && region !== "00") params.append('region', region);
        if (municipio && municipio !== "000") params.append('municipio', municipio);
        if (localidad && localidad !== "0000") params.append('localidad', localidad);
        if (padron && padron !== "0000") params.append('padron', padron);
        alert(params.toString());
        await fetch('/Seguimiento/padronesBeneficiariosPuntos?' + params.toString())
        //fetch('/Seguimiento/padronesBeneficiariosPuntos')
            .then(response => {
                 if (!response.ok) {
                     throw new Error('Error en la respuesta del servidor');
                 }
                 return response.json();
            })
            .then(data => {
                marcadoresGroup.clearLayers();
                var bounds = [];
                data.forEach(puntuacion => {
                    if (puntuacion.latitud && puntuacion.longitud) 
                    {
                        var iconoProyecto = obtenerIconoPorProyecto(puntuacion.idProyecto);
                        var marker = L.marker([puntuacion.latitud, puntuacion.longitud], {icon: iconoProyecto})
                            .addTo(marcadoresGroup)
                            .bindPopup(`<b>${puntuacion.nombreBeneficiarios} - ${puntuacion.nombreProyecto}</b>`)
                            //.openPopup();
                        bounds.push([puntuacion.latitud, puntuacion.longitud]);
                    }
                });
                if (bounds.length > 0) {
                    map.fitBounds(bounds); // Ajusta el zoom para ver todos los puntos
                }
            })
            .catch(error => {
                console.error('Error al cargar los puntos en el mapa:', error);
            });
    }
    
    function obtenerColorPorProyecto(idProyecto) {
        const colores = {
        'AC': '#e74c3c',       // Rojo
        'DASV': '#2ecc71',     // Verde
        'IFPAPTEV': '#9b59b6'}  // Morado        ;
        return colores[idProyecto] || 'hue-rotate(0deg) brightness(1)';
    }

    function obtenerIconoPorProyecto(idProyecto) {
        const rutasIconos = {
            'AC': '/apicutura.png',         // Ruta a tu imagen de la abeja
            'DASV': '/pez-payaso.png',       // Ruta a la imagen de DASV
            'IFPAPTEV': '/aves.png',     // Ruta a la imagen de IFPAPTEV
            'IATF': '/inseminacion.png'  // Ruta a la imagen de IATF
        };
        var rutaImagen = rutasIconos[idProyecto] || '/img/default.png';
        return L.icon({
            iconUrl: rutaImagen,
            iconSize: [30, 30],      // Tamaño del ícono en píxeles [ancho, alto]
            iconAnchor: [15, 30],    // Punto del ícono que se alinea con la coordenada (mitad ancho, alto total)
            popupAnchor: [0, -30]    // Posición donde emerge la ventana popup sobre el ícono
        });
    }

    function crearIconoPin(colorHex) {
        return L.divIcon({
            className: 'custom-pin-marker',
            html: `<svg width="25" height="41" viewBox="0 0 25 41" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12.5 0C5.6 0 0 5.6 0 12.5C0 21.9 12.5 41 12.5 41S25 21.9 25 12.5C25 5.6 19.4 0 12.5 0Z" 
                          fill="${colorHex}" stroke="#FFFFFF" stroke-width="1.5"/>
                    <circle cx="12.5" cy="12.5" r="4" fill="#FFFFFF"/>
                   </svg>`,
            iconSize: [25, 41],
            iconAnchor: [12, 41],
            popupAnchor: [1, -34]
        });
    }

</script>