    function cargarPadronesMapa() 
    {

        if (!map) {
            var limitesVeracruz = L.latLngBounds(
                L.latLng(17.10, -98.60), // Esquina Suroeste
                L.latLng(22.50, -93.50)  // Esquina Noreste
            );
        
            map = L.map('mapa', {
                maxBounds: limitesVeracruz,
                maxBoundsViscosity: 1.0,
                minZoom: 7,
                maxZoom: 18
            }).fitBounds(limitesVeracruz);

            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(map);

            marcadoresGroup = L.layerGroup().addTo(map);
        }

        setTimeout(() => { 
            if (map) map.invalidateSize(); 
        }, 200);
        //setTimeout(() => { map.invalidateSize(); }, 200);

        obtenerPuntosPadrones();

        //renderizarMapa(listaUpp);
        //cargarRegiones();
        //cargarMunicipios();

    }

    async function obtenerPuntosPadrones() 
    {
        
        //Generar parámetros de búsqueda según los filtros seleccionados
        const anioReporte = document.getElementById('txtAño').value;
        const nombre = document.getElementById('txtNombre').value;
        const region = document.getElementById('cmbRegion').value;
        const municipio = document.getElementById('cmbMunicipio').value;
        const localidad = document.getElementById('cmbLocalidad').value;
        //const padron = document.getElementById('cmbPadron').value;
        const proyectosSel = Array.from(document.getElementById('cmbPadron').selectedOptions).map(o => o.value);

        //Agregar los valores a la URL de la petición
        const params = new URLSearchParams();
        if (anioReporte) params.append('anioReporte', anioReporte);
        if (nombre) params.append('nombre', nombre);
        if (region && region !== "00") params.append('region', region);
        if (municipio && municipio !== "000") params.append('municipio', municipio);
        if (localidad && localidad !== "0000") params.append('localidad', localidad);
        //if (padron && padron !== "0000") params.append('padron', padron);
        if (proyectosSel.length > 0) {
            proyectosSel.forEach(proyecto => params.append('padron', proyecto));
        }

        await fetch('/Seguimiento/padronesBeneficiariosPuntos?' + params.toString())
        //fetch('/Seguimiento/padronesBeneficiariosPuntos')
            .then(response => {
                 if (!response.ok) {
                     throw new Error('Error en la respuesta del servidor');
                 }
                 return response.json();
            })
            .then(data => {
                marcadoresGroup.clearLayers();
                var bounds = [];
                data.forEach(puntuacion => {
                    if (puntuacion.latitud && puntuacion.longitud) 
                    {
                        var iconoProyecto = obtenerIconoPorProyecto(puntuacion.idProyecto);
                        var marker = L.marker([puntuacion.latitud, puntuacion.longitud], {icon: iconoProyecto})
                            .addTo(marcadoresGroup)
                            .bindPopup(`<b>${puntuacion.nombreBeneficiarios} - ${puntuacion.nombreProyecto}</b>`)
                            //.openPopup();
                        bounds.push([puntuacion.latitud, puntuacion.longitud]);
                    }
                });
                if (bounds.length > 0) {
                    map.fitBounds(bounds); // Ajusta el zoom para ver todos los puntos
                }
            })
            .catch(error => {
                console.error('Error al cargar los puntos en el mapa:', error);
            });
    }
    
    function obtenerColorPorProyecto(idProyecto) {
        const colores = {
        'AC': '#e74c3c',       // Rojo
        'DASV': '#2ecc71',     // Verde
        'IFPAPTEV': '#9b59b6'}  // Morado        ;
        return colores[idProyecto] || 'hue-rotate(0deg) brightness(1)';
    }

    function obtenerIconoPorProyecto(idProyecto) {
        const rutasIconos = {
            'AC': '/apicutura.png',         // Ruta a tu imagen de la abeja
            'DASV': '/pez-payaso.png',       // Ruta a la imagen de DASV
            'IFPAPTEV': '/aves.png',     // Ruta a la imagen de IFPAPTEV
            'IATF': '/inseminacion.png'  // Ruta a la imagen de IATF
        };
        var rutaImagen = rutasIconos[idProyecto] || '/img/default.png';
        return L.icon({
            iconUrl: rutaImagen,
            iconSize: [30, 30],      // Tamaño del ícono en píxeles [ancho, alto]
            iconAnchor: [15, 30],    // Punto del ícono que se alinea con la coordenada (mitad ancho, alto total)
            popupAnchor: [0, -30]    // Posición donde emerge la ventana popup sobre el ícono
        });
    }

    function crearIconoPin(colorHex) {
        return L.divIcon({
            className: 'custom-pin-marker',
            html: `<svg width="25" height="41" viewBox="0 0 25 41" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12.5 0C5.6 0 0 5.6 0 12.5C0 21.9 12.5 41 12.5 41S25 21.9 25 12.5C25 5.6 19.4 0 12.5 0Z" 
                          fill="${colorHex}" stroke="#FFFFFF" stroke-width="1.5"/>
                    <circle cx="12.5" cy="12.5" r="4" fill="#FFFFFF"/>
                   </svg>`,
            iconSize: [25, 41],
            iconAnchor: [12, 41],
            popupAnchor: [1, -34]
        });
    }

    function cargarGrafica(PGrafica){
        //Variables que se usan para definir la gráfica a presentar y obtener los datos
        let opcion = parseInt(PGrafica, 10);
        let urlEstadistica = '';
        let labelGrafica = '';

        //Genera la variable de los parfámetros
        const params = new URLSearchParams();
        const proyectosSel = Array.from(document.getElementById('cmbPadron').selectedOptions).map(o => o.value);
        const proyectosFiltrados = proyectosSel.filter(p => p !== '0000' && p !== '' && p !== '0');
        if (proyectosFiltrados.length > 0) {
            proyectosFiltrados.forEach(p => params.append('proyectos', p));
        }
        //Genera la url dependienndo de la olpción que se seleccionó en el combo
        switch (opcion) {
            case 1:
                urlEstadistica = '/Seguimiento/PadronesBeneficiariosEstadisticas?' + params.toString();
                labelGrafica = 'Beneficiarios por Programa';
                break;
            case 2:
                urlEstadistica = '/Seguimiento/PadronesBeneficiariosApicultura5mas';
                labelGrafica = 'Municpios con mayor cantidad de beneficiarios'
                break;
            case 3:
                urlEstadistica = '/Seguimiento/PadronesBeneficiariosAves5mas';
                labelGrafica = 'Municpios con mayor cantidad de beneficiarios'
                break;
            case 4:
                urlEstadistica = '/Seguimiento/PadronesBeneficiariosAcuacultura5mas';
                labelGrafica = 'Municpios con mayor cantidad de beneficiarios'
                break;
            case 5:
                urlEstadistica = '/Seguimiento/PadronesBeneficiariosInseminacion5mas';
                labelGrafica = 'Municpios con mayor cantidad de beneficiarios'
                break;
        }
        //Presenta las gráficas
        const valorSeleccionado = document.querySelector('input[name="tipoGrafica"]:checked')?.value || 'bar';
        mostrarGrafica(urlEstadistica,valorSeleccionado, labelGrafica);
    }

    async function mostrarGrafica(PUrl, PGrafica, PLabel) { 
        try {
            const response = await fetch(PUrl);
            const data = await response.json();
            const ctx = document.getElementById('dashboardChart').getContext('2d');
            // Destruir la instancia previa si ya existía para evitar encimados
            if (chartInstance) {
                chartInstance.destroy();
            }
            //Palate de colores en  caso de pastel o donas
            const paletaColores = [
                '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b',
                '#858796', '#5a5c69', '#f8f9fc', '#4e73df', '#1cc88a'
            ];
            //Asigna paleta de colores en caso de que sea una barra de pastel o de donas
            const bgColors = (PGrafica === 'pie' || PGrafica === 'doughnut')
                ? paletaColores.slice(0, data.values.length)
                : '#6c757d';
            //Dibuja la gráfica
            chartInstance = new Chart(ctx, {
                type: PGrafica,
                data: {
                    labels: data.labels,
                    datasets: [{
                        label: PLabel,
                        data: data.values,
                        backgroundColor: bgColors,
                        borderColor: '#ffffff',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });
            //Mostrar la tabla con los valores
            const thead = document.getElementById('tblEstadisticasHead');
            const tbody = document.getElementById('tblEstadisticasBody');
            //Encabezado
            var cadenaHead = "";
            data.labels.forEach((label, index) => {
                cadenaHead = cadenaHead + `<th class="p-2">${label}</th>`
            });
            thead.innerHTML = `<tr>${cadenaHead}</tr>`;
            //Datos
            var cadenaBody = "";
            data.values.forEach((valor, index) => {
                cadenaBody = cadenaBody + `<td class="p-2">${valor}</td>`
            });
            tbody.innerHTML = `<tr>${cadenaBody}</tr>`;
        } catch (error) {
            console.error("Error al cargar gráfica:", error);
        }
    }

</script>