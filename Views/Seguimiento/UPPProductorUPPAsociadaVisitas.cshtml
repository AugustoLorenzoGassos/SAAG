@model IEnumerable<Seguimiento.Models.ProduccionUpp>

@{
    ViewData["Title"] = "Registro de productores - Visitas UPP";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-secondary bg-gradient text-white">
            <h4 class="m-0">Registro de productores - Visitas UPP</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-3">
                    Productor:<br />@Model.FirstOrDefault()?.IdProductorUppNavigation?.IdProductorNavigation?.NombreProductor @Model.FirstOrDefault()?.IdProductorUppNavigation?.IdProductorNavigation?.ApellidoPaternoProductor @Model.FirstOrDefault()?.IdProductorUppNavigation?.IdProductorNavigation?.ApellidoMaternoProductor
                </div>
                <div class="col-12 col-md-3">
                    UPP:<br />@Model.FirstOrDefault()?.IdProductorUppNavigation?.ClaveUpp
                </div>
                <div class="col-12 col-md-3">
                    Municipio:<br />@(Model.FirstOrDefault()?.IdProductorUppNavigation?.CatalogoLocalidade?.ClaveMunicipioNavigation.NombreMunicipio ?? "Sin municipio")
                </div>
                <div class="col-12 col-md-3">
                    Localidad:<br />@(Model.FirstOrDefault()?.IdProductorUppNavigation?.CatalogoLocalidade?.NombreLocalidad ?? "Sin localidad")
                </div>
                <table class="table table-striped table-hover table-bordered mt-4" style="font-size:small" id="tablaVisitas">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Nombre de quien registra</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var visita in Model)
                        {
                            <tr>
                                <td>@visita.FechaRegistro</td>
                                <td>@visita.IdUsuarioNavigation?.NombreUsuario</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Acciones">
                                        <button type="button" class="btn" title="Ver datos de la vicita" onclick="mostrarDatosVisitasUPP(@visita.IdRegistroProduccion);" title="Editar acción de seguimiento">
                                            <i class="fa fa-tasks"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <!-- Botones de acción en flex responsivo -->
            <div class="container-fluid d-flex flex-column flex-md-row w-100 justify-content-start">
                <div class="me-md-2">
                    <!-- Acción para regresar a la lista de registros mensuales -->
                    <a href="@Url.Action("UPPProductorUPPAsociadas", "Seguimiento", new { id = @ViewBag.IdProductorUpp })" class="btn btn-light w-100 w-md-auto">
                        <i class="fa fa-bars me-1" aria-hidden="true"></i>Regresar a la lista de UPP's
                    </a>
                </div>
                <div class="mt-2 mt-md-0">
                    <!-- Acción para agregar una nueva visita -->
                    <a href="@Url.Action("UPPProductorUPPAsociadaVisitasAgregar", "Seguimiento", new { id = @ViewBag.IdProductorUpp })" class="btn btn-light w-100 w-md-auto">
                        <i class="fa fa-plus-square me-1" aria-hidden="true"></i>Agregar visita
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    function mostrarDatosVisitasUPP(id)
    {
        const url = `@Url.Action("UPPProductorUPPAsociadaVisitasDetalle", "Seguimiento")?id=${id}`;
        window.location.href = url;
    }

</script>