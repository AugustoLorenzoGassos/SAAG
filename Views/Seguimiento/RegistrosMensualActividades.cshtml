@model Seguimiento.Models.TblRegistroMensual

@{
    ViewData["Title"] = "Detalle de Reporte Mensual";
}

<div class="container mt-4">
    <div class="card">
        <!-- Encabezado -->
        <div class="card-header bg-secondary bg-gradient text-white">
            <h4 class="m-0">Registro mensual - Acciones de seguimiento</h4>
        </div>
        <!-- Datos del usuario y laboratorio -->
        <div class="card-body">
            <!-- Información General -->
            <div class="row mb-4">
                <div class="col-md-4">
                    Laboratorio móvil:<br />@(Model.IdLaboratorioNavigation.NombreLaboratorio ?? "N/A")
                </div>
                <div class="col-md-4">
                    Mes de Reporte:<br />@ViewBag.mesReporte
                </div>
                <div class="col-md-4">
                    Año de Reporte:<br />@(Model.AñoReporte?.ToString() ?? "N/A")
                </div>
            </div>
            <!-- Tabla de detalles -->            
            @if (Model.TblRegistroMensualDetalles != null && Model.TblRegistroMensualDetalles.Any())
            {
                <div class="table-responsive table-striped">
                    <table class="table table-striped table-hover table-bordered" style="font-size:small" id="tablaRegistrosDetalles">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Productor</th>
                                <th>CPS MCM</th>
                                <th>CPC Flotac</th>
                                <th>CPC Sedim</th>
                                <th>CPC Bearm</th>
                                <th>DX SC BH</th>
                                <th>DX SC SC</th>
                                <th>Mastitis</th>
                                <th>Días de Gestación</th>
                                <th>Asesoramiento Zoosanitario</th>
                                <th>Profilaxis Equina</th>
                                <th>Total</th>
                                <th>Acciones</th>
                             </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in Model.TblRegistroMensualDetalles)
                            {
                                <tr>
                                    <td>@detalle.FechaReporte?.ToString("dd/MM/yyyy")</td>
                                    <td>@detalle.IdProductorNavigation.NombreProductor</td>
                                    <td>@detalle.CpsMcm</td>
                                    <td>@detalle.CpcFlotac</td>
                                    <td>@detalle.CpcSedim</td>
                                    <td>@detalle.CpcBearm</td>
                                    <td>@detalle.DxScBh</td>
                                    <td>@detalle.DxScSc</td>
                                    <td>@detalle.Mastitis</td>
                                    <td>@detalle.DiasGestacion</td>
                                    <td>@detalle.AsesoramientoZoosanitarui</td>
                                    <td>@detalle.ProfilaxisEquina</td>
                                    <td>@detalle.Total</td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Acciones">
                                            <button type="button" class="btn" onclick="editarAccion(@detalle.IdReporteMensualAccion);" title="Editar acción de seguimiento">
                                                <i class="fa fa-pencil"></i>
                                            </button>
                                            <button type="button" class="btn" onclick="eliminarAccion(@detalle.IdReporteMensualAccion);" title="Eliminar acción">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-success text-center" role="alert">
                    No hay detalles registrados para este reporte.
                </div>
            }
        </div>
        <!-- Pie de página con botones de acción -->
        <div class="card-footer">
            <div class="container-fluid d-flex flex-column flex-md-row w-100 justify-content-start">
                <div class="me-md-2">
                    <a id="btnRegresarListaReportes" href="@Url.Action("RegistrosMensualInicio", "Seguimiento")" class="btn btn-light w-100 w-md-auto">
                        <i class="fa fa-tasks me-3" aria-hidden="true"></i>Regresar a la lista de registros mensuales
                    </a>
                </div>
                <div class="mt-2 mt-md-0">
                    <a id="btnRegistrarAcciones" href="@Url.Action("listaRegistrosMensualAgregarAccion", "Seguimiento", new { id = Model.IdReporteMensual })" class="btn btn-light w-100 w-md-auto">
                        <i class="fa fa-plus-square m-0 p-1" aria-hidden="true"></i>Agregar acciones de seguimiento
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    //Función que dispara la acción para editar los datos de la acción
    function editarAccion(id)
    {
        const url = `@Url.Action("listaRegistrosMensualEditarAccion", "Seguimiento")?id=${id}`;
        window.location.href = url
    }
    //Función que dispara la acción para eliminar una acción
    function eliminarAccion(id)
    {
        const url = `@Url.Action("listaRegistrosMensualEliminarAccion", "Seguimiento")?id=${id}`;
        window.location.href = url
    }
</script>