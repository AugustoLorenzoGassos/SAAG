@model Seguimiento.Models.ProduccionUpp

@{
    ViewData["Title"] = "Registro de productores - Visitas UPP - Agregar";
}

<div class="container mt-4">
    <form action="/Seguimiento/UPPProductorUPPAsociadaVisitasAgregar" method="post">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model=>model.IdRegistroProduccion)
        @Html.HiddenFor(model => model.FechaCaptura)
        @Html.HiddenFor(model => model.IdUsuario)
        @Html.HiddenFor(model => model.IdProductorUpp)
        @Html.HiddenFor(model => model.IdEtapaRegistro)
        <div class="card">
            <div class="card-header bg-secondary bg-gradient text-white">
                <h4 class="m-0">Registro de productores - Visitas UPP - Agregar visita</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12 col-md-4">
                        Clave UPP:<br />ViewBag.claveUPP
                    </div>
                    <div class="col-12 col-md-4">
                        Productor:<br />ViewBag.Productor
                    </div>
                    <div class="col-12 col-md-4">
                        Municipio - Localidad:<br />ViewBag.Municipio - ViewBag.Localidad
                    </div>
                </div>
                @ViewBag.claveUPP
                <div class="row">
                    <div class="col-12 col-md-3">
                        <label for="txtFechaRegistro">Fecha de visita:</label>
                        <input id="txtFechaRegistro" name="fechaRegistro" type="date" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <!-- Botones de acción en flex responsivo -->
                <div class="container-fluid d-flex flex-column flex-md-row w-100 justify-content-start">
                    <div class="me-md-2">
                        <!-- Acción para regresar a la lista de registros mensuales -->
                        <a href="@Url.Action("UPPProductorUPPAsociadaVisitas", "Seguimiento", new { id = @Model.IdProductorUpp })" class="btn btn-light w-100 w-md-auto">
                            <i class="fa fa-bars me-1" aria-hidden="true"></i>Regresar a la lista de visitas
                        </a>
                    </div>
                    <div class="mt-2 mt-md-0">
                        <!-- Botón para guardar un registro nuevo -->
                        <button type="submit" id="btnGuardar" class="btn btn-light mt-2 mt-md-0 w-100 w-md-auto">
                            <i class="fa fa-save me-1" aria-hidden="true"></i>Guardar registro
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
